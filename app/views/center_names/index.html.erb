<div class="text-start mb-3">
  <%= link_to new_center_name_path, data: { turbo_frame:"remote_modal" }, class: 'btn btn-primary' do %>
    New Center Name
  <% end %>
  <%#link_to '75-80 350,001 and above', center_names_path(cn, type: "7680a"), class: 'btn btn-secondary btn-sm' %>
</div>

<%= content_tag :h1, "List of Center Names" %>
<div class="row mb-3">
  <div class="col-md-9">
    <%== pagy_bootstrap_nav(@pagy) %>
    <%== pagy_info(@pagy) %>
  </div>
  <div class="col-md-3">
    <% dqry = params[:query] %>
    <%= form_with( url: center_names_path, method: :get, data: {turbo_frame: "se_description"} ) do |form| %>
    <div class="input-group mb-3">
      <%= form.text_field :query, placeholder: 'Search by Description...', class: "form-control" %>
      <%= form.submit 'Search', class: "btn btn-success" %>
      <% if dqry.present? == true %>
        <%= link_to '<i class="bi bi-arrow-counterclockwise"></i>'.html_safe, center_names_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
    <% end %>
  </div>
</div>
<table class="table table-striped table-bordered table-hover">
  <thead>
    <tr>
      <th>#</th>
      <th>Description</th>
      <th>No. of Member(s)</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @center_names.each do |center_name| %>
    <tr id="t_desc">
      <th scope="row"><%= center_name.id %></th>
      <td>
        <div class="text-wrap fw-bold">
          <span class="badge bg-secondary"><%= center_name.branch %></span> <strong><%= center_name.description %></strong>
        </div>
      </td>
      <td>
        <div class="text-wrap fw-bold">
          <small><%= center_name.coverages.count %></small>
        </div>
      </td>
      <td>
        <%= link_to 'View', center_name, class: 'btn btn-secondary btn-sm' %>
        <%= link_to 'Edit', edit_center_name_path(center_name), data: { turbo_frame:"remote_modal" }, class: 'btn btn-secondary btn-sm' %>
        <%= link_to "Delete", center_name, class: "btn btn-danger btn-sm", method: :delete, data: { "turbo-method": :delete, turbo_confirm: "Are you sure?" } %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
